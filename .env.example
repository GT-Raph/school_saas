DEBUG=True

SECRET_KEY=replace-me

ALLOWED_HOSTS=127.0.0.1,localhost

CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

DEV_TENANT_SLUG=demo-international-school

DEFAULT_TENANT_SLUG=demo-international-school

# Supabase session-mode pooler URL for
# Render application traffic.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Direct URL for pg_dump, restore and
# database administration where IPv6 is available.
DIRECT_DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

LOG_LEVEL=INFO

BOOTSTRAP_ADMIN_USERNAME=platform_admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-temporary-password